# Local (desarrollo) — SQLite
DATABASE_URL="file:./dev.db"

# Railway (producción) — SQLite sobre volumen persistente
# DATABASE_URL="file:/data/dev.db"

# JWT
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=8h

# Local: true para crear usuarios de prueba. Railway: false por defecto.
SEED_USERS=true
# Railway opcional: crea un único administrador inicial con estas variables.
# SEED_ADMIN_NAME=Administrador TIVIT
# SEED_ADMIN_EMAIL=admin@tu-dominio.com
# SEED_ADMIN_PASSWORD=replace_with_a_strong_password

# App
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Railway: fija el puerto y usa cookies seguras detrás de HTTPS
# COOKIE_SECURE=true
