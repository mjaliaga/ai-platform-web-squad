# =============================================================================
# TIVIT AI Platform — .gitignore
# Stack: Rust (Axum), React (Vite), Python, Docker
# =============================================================================


# =============================================================================
# Environment and Secrets
# =============================================================================
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12


# =============================================================================
# Rust / Cargo
# =============================================================================
target/
**/*.rs.bk
Cargo.lock.bk
# Keep Cargo.lock for binary crates (backend is a binary — Cargo.lock is committed)
# Remove the line below if this is a library crate
# Cargo.lock


# =============================================================================
# Node / npm
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# Vite build output
dist/
build/

# TypeScript cache
*.tsbuildinfo


# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
*.egg
dist/
.venv/
venv/
env/
.env/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
coverage.xml
*.cover
htmlcov/


# =============================================================================
# SQLite Databases
# =============================================================================
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3


# =============================================================================
# Logs
# =============================================================================
*.log
logs/


# =============================================================================
# Docker
# =============================================================================
# Do not ignore docker-compose.yml or Dockerfiles — they are versioned.
# Ignore override files that may contain local secrets.
docker-compose.override.yml


# =============================================================================
# Media and Uploads (large binary files)
# =============================================================================
# Local video files should not be committed — use YouTube/Vimeo embeds instead.
# Static images in public/media/ ARE committed (they are small and part of the build).
frontend/public/media/**/*.mp4
frontend/public/media/**/*.mov
frontend/public/media/**/*.avi
frontend/public/media/**/*.mkv
frontend/public/media/**/*.webm

# CMS media uploads (runtime, stored in Docker volume — not part of source)
backend-rust/data/
backend-rust/media/


# =============================================================================
# Generated Files
# =============================================================================
# items.json is generated by the ingestion script — it is committed intentionally
# to allow the frontend to build without requiring script execution.
# Do not add frontend/src/data/items.json here.


# =============================================================================
# Operating System
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# =============================================================================
# Editors and IDEs
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
