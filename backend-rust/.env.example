# --- Base de datos ---
DATABASE_URL=sqlite://data/portal.db

# --- JWT (requerido, sin default inseguro) ---
# Generar con: openssl rand -hex 64
# JWT_SECRET=  # <-- SETEAR con valor generado, ej: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Servidor ---
PORT=3000
CORS_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
UPLOAD_DIR=data/uploads

# --- Rate limiting distribuido (opcional pero recomendado) ---
# Si no se setea, usa un limiter en memoria (una sola instancia)
# REDIS_URL=redis://redis:6379

# --- Admin inicial (opt-in: ambos requeridos, password mín 8 y no débil) ---
# Descomentar para habilitar seed en primer arranque
# SEED_ADMIN_EMAIL=admin@tivit.com
# SEED_ADMIN_PASSWORD=ReplaceWithAStrongPassword!2026
# SEED_ADMIN_NAME=Admin

# --- Brevo (email) ---
# BREVO_API_KEY=xkeysib-... (NO xsmtpsib)
# BREVO_SENDER_EMAIL=noreply@31032005.xyz
# BREVO_SENDER_NAME=TIVIT Portal
# FRONTEND_URL=http://10.249.27.210:8080
# BREVO_SENDER_EMAIL debe ser de dominio autenticado en Brevo (SPF/DKIM)
