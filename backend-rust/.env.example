# --- Base de datos ---
DATABASE_URL=sqlite://data/portal.db

# --- JWT (requerido, sin default inseguro) ---
# Generar con: openssl rand -hex 64
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# --- Servidor ---
PORT=3000
CORS_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
UPLOAD_DIR=data/uploads

# --- Rate limiting distribuido (opcional pero recomendado) ---
# Si no se setea, usa un limiter en memoria (una sola instancia)
# REDIS_URL=redis://redis:6379

# --- Admin inicial ---
SEED_ADMIN_EMAIL=manuel.aliaga@tivit.com
SEED_ADMIN_PASSWORD=tivit2026
SEED_ADMIN_NAME=Admin
