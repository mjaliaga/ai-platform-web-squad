# =============================================================================
# TIVIT AI Platform — Environment Variables Example
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# Generate JWT_SECRET with: openssl rand -hex 64
# =============================================================================

# --- Backend (Rust) ---
# REQUIRED: Random secret used for JWT signing (min 32 chars, recommended 64+ hex)
JWT_SECRET=

# Optional: Token lifetime (default: 8h)
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed CORS origins. In production, MUST be set explicitly.
# Example: https://portal.tivit.com,https://www.tivit.com
CORS_ORIGIN=http://localhost:8080

# Set to true ONLY behind HTTPS termination (production). Default false in dev.
COOKIE_SECURE=false

# Redis URL for distributed rate limiting (optional but recommended)
REDIS_URL=redis://redis:6379

# --- Admin seed (optional, opt-in) ---
# To enable admin seeding on first run, set BOTH of these.
# SEED_ADMIN_PASSWORD must be at least 12 characters and not on the weak-password blocklist.
# SEED_ADMIN_EMAIL=admin@tivit.com
# SEED_ADMIN_PASSWORD=ReplaceWithAStrongPassword!2026
# SEED_ADMIN_NAME=Admin

# --- Frontend (Vite, baked at build time) ---
# Relative URL proxied by nginx in production, or full URL for separate deployments.
VITE_API_URL=/api
# Set to true in dev to show demo credentials on the login page.
VITE_SHOW_DEMO_CREDENTIALS=false

# --- Runtime ---
# Host port published by the frontend container (default 8080)
PORT=8080

# --- Brevo (email) — opcional, si no se setea solo hay notificación in-app ---
# BREVO_API_KEY=xkeysib-... (generar en Brevo > SMTP & API > API Keys, NO xsmtpsib)
# BREVO_SENDER_EMAIL=noreply@31032005.xyz
# BREVO_SENDER_NAME=TIVIT Portal
# FRONTEND_URL=http://10.249.27.210:8080
